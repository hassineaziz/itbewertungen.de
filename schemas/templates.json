            "required": true
          },
          "asin": {
            "type": "text",
            "label": "Amazon ASIN (optional)",
            "placeholder": "B0CGMS3XBB"
          },
          "name": {
            "type": "text",
            "label": "Product Name",
            "required": true
          },
          "badge": {
            "type": "text",
            "label": "Badge (Best for...)"
          },
          "price": {
            "type": "text",
            "label": "Price",
            "required": true
          },
          "rating": {
            "type": "number",
            "label": "Rating (0–10)",
            "step": "0.1"
          },
          "image_url": {
            "type": "text",
            "label": "Image URL"
          },
          "summary": {
            "type": "textarea",
