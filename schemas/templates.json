      },
      "comparison_table": {
        "type": "table",
        "label": "Comparison Table",
        "columns": [
          {
            "key": "model",
            "label": "Modell",
            "type": "text"
          },
          {
            "key": "badge",
            "label": "Badge / Eignung",
            "type": "text"
          },
          {
            "key": "rating",
            "label": "Bewertung",
            "type": "text"
          },
          {
            "key": "price",
            "label": "Preis",
            "type": "text"
          }
        ]
      },
      "faq": {
        "type": "array",
        "label": "FAQ",
        "addLabel": "Add FAQ Item",
        "fields": {
          "question": {
            "type": "text",
            "label": "Question",
            "required": true
          },
          "answer": {
            "type": "textarea",
            "label": "Answer",
            "required": true,
            "rows": 3
          }
        }
      },
      "verdict": {
        "type": "textarea",
        "label": "Final Verdict / Conclusion",
        "placeholder": "Zusammenfassung und Empfehlung...",
        "rows": 5
      }
    }
  }
}